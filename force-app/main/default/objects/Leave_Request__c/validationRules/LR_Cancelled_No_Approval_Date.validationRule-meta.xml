<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LR_Cancelled_No_Approval_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c,&quot;Cancelled&quot;),
    NOT(ISBLANK(Approval_Date__c))
)</errorConditionFormula>
    <errorMessage>Cancelled leave should not have an Approval Date.</errorMessage>
</ValidationRule>
