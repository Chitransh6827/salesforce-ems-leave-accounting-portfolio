<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LR_Future_Applied_Date</fullName>
    <active>true</active>
    <errorConditionFormula>Applied_Date__c &gt; TODAY()</errorConditionFormula>
    <errorDisplayField>Applied_Date__c</errorDisplayField>
    <errorMessage>Applied Date cannot be in the future.</errorMessage>
</ValidationRule>
