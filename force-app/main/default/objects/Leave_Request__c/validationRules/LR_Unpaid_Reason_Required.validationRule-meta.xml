<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LR_Unpaid_Reason_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Leave_Type__c,&quot;Unpaid&quot;),
    ISBLANK(Reason__c)
)</errorConditionFormula>
    <errorMessage>Reason is required for Unpaid Leave.</errorMessage>
</ValidationRule>
