<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LR_Approval_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c,&quot;Approved&quot;),
    ISBLANK(Approval_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Approval_Date__c</errorDisplayField>
    <errorMessage>Approval Date is required when leave is approved.</errorMessage>
</ValidationRule>
