<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ATD_Absent_No_Time_Allowed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Absent&quot;),
    OR(
        NOT(ISBLANK(Check_in_Time__c)),
        NOT(ISBLANK(Check_out_Time__c))
    )
)</errorConditionFormula>
    <errorMessage>Absent employees cannot have check-in or check-out times.</errorMessage>
</ValidationRule>
