<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ATD_Present_Checkin_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Present&quot;),
    ISBLANK(Check_in_Time__c)
)</errorConditionFormula>
    <errorMessage>Present employees must have a check-in time.</errorMessage>
</ValidationRule>
