<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ATD_Checkout_Before_Checkin</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Check_in_Time__c)),
    NOT(ISBLANK(Check_out_Time__c)),
    Check_out_Time__c &lt;= Check_in_Time__c
)</errorConditionFormula>
    <errorDisplayField>Check_out_Time__c</errorDisplayField>
    <errorMessage>Check-out time must be after check-in time.</errorMessage>
</ValidationRule>
