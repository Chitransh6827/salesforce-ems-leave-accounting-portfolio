<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DEPT_Description_Too_Short</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Description__c)),
    LEN(TRIM(Description__c)) &lt; 10
)</errorConditionFormula>
    <errorDisplayField>Description__c</errorDisplayField>
    <errorMessage>Description must contain at least 10 characters.</errorMessage>
</ValidationRule>
