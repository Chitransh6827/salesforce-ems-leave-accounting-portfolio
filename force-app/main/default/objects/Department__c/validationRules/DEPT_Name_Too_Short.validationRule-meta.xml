<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DEPT_Name_Too_Short</fullName>
    <active>true</active>
    <errorConditionFormula>LEN(TRIM(Name)) &lt; 2</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>Department Name must contain at least 2 characters.</errorMessage>
</ValidationRule>
