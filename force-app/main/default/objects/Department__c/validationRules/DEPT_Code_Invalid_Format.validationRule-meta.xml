<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DEPT_Code_Invalid_Format</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Department_Code__c)),
    NOT(
        REGEX(
            Department_Code__c,
            &quot;^[A-Z]{2,10}$&quot;
        )
    )
)</errorConditionFormula>
    <errorDisplayField>Department_Code__c</errorDisplayField>
    <errorMessage>Department Code must contain only uppercase letters (2–10 characters).</errorMessage>
</ValidationRule>
