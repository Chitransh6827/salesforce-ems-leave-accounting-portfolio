<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Employee_Last_Name_Valid</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Last_Name__c)),
    NOT(
        REGEX(
            Last_Name__c,
            &quot;^[A-Za-z][A-Za-z &apos;-]*$&quot;
        )
    )
)</errorConditionFormula>
    <errorDisplayField>Last_Name__c</errorDisplayField>
    <errorMessage>Enter a valid last name using letters, spaces, apostrophes, or hyphens.</errorMessage>
</ValidationRule>
