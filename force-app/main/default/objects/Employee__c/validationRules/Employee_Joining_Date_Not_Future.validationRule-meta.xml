<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Employee_Joining_Date_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Joining_Date__c)),
    Joining_Date__c &gt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>Joining_Date__c</errorDisplayField>
    <errorMessage>Joining date cannot be in the future.</errorMessage>
</ValidationRule>
