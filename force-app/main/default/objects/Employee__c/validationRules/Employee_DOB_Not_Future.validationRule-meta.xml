<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Employee_DOB_Not_Future</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Date_of_Birth__c)),
    Date_of_Birth__c &gt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>Date_of_Birth__c</errorDisplayField>
    <errorMessage>Date of birth cannot be in the future.</errorMessage>
</ValidationRule>
