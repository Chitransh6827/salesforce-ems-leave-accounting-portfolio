<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LB_Used_Greater_Than_Total</fullName>
    <active>true</active>
    <errorConditionFormula>Used_Leaves__c &gt; Total_Leaves__c</errorConditionFormula>
    <errorMessage>Used Leaves cannot exceed Total Leaves.</errorMessage>
</ValidationRule>
