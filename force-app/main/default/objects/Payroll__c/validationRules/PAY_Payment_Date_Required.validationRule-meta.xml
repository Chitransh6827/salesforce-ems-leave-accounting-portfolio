<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PAY_Payment_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Payment_Status__c,&quot;Paid&quot;),
    ISBLANK(Payment_Date__c)
)</errorConditionFormula>
    <errorDisplayField>Payment_Date__c</errorDisplayField>
    <errorMessage>Payment Date is required when payroll is paid.</errorMessage>
</ValidationRule>
