<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PR_Finalized_Score_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Review_Status__c,&quot;Finalized&quot;),
    ISBLANK(Performance_Score__c)
)</errorConditionFormula>
    <errorMessage>Performance Score is required before finalizing the review.</errorMessage>
</ValidationRule>
