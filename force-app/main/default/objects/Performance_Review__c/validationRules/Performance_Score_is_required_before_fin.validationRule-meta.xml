<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Performance_Score_is_required_before_fin</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Performance_Score__c &lt; 0,
    Performance_Score__c &gt; 100
)</errorConditionFormula>
    <errorMessage>Performance Score must be between 0 and 100.</errorMessage>
</ValidationRule>
