<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PR_Poor_Rating_Comments_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Rating__c,&quot;Poor&quot;),
    ISBLANK(Comments__c)
)</errorConditionFormula>
    <errorMessage>Comments are required for a Poor rating.</errorMessage>
</ValidationRule>
