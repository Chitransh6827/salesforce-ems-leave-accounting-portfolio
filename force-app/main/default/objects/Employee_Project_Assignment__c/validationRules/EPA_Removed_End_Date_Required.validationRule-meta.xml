<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EPA_Removed_End_Date_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Removed&quot;),
    ISBLANK(End_Date__c)
)</errorConditionFormula>
    <errorMessage>Removed assignments require an End Date.</errorMessage>
</ValidationRule>
