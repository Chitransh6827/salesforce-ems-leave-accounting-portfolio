<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>EPA_Invalid_Allocation</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Allocation_Percentage__c &lt;= 0,
    Allocation_Percentage__c &gt; 100
)</errorConditionFormula>
    <errorDisplayField>Allocation_Percentage__c</errorDisplayField>
    <errorMessage>Allocation Percentage must be between 1% and 100%.</errorMessage>
</ValidationRule>
