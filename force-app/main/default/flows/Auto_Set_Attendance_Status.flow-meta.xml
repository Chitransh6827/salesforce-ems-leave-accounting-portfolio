<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Absent</name>
        <label>Absent</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Absent</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Half_Day</name>
        <label>Set Half Day</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Half Day</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Present</name>
        <label>Set Present</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Status__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Present</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Determine_Attendance_Status</name>
        <label>Determine Attendance Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Absent</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Absent</defaultConnectorLabel>
        <rules>
            <name>Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>flow_Working_Hours</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>8.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Present</targetReference>
            </connector>
            <label>Present</label>
        </rules>
        <rules>
            <name>Half_Day</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>flow_Working_Hours</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>4.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Half_Day</targetReference>
            </connector>
            <label>Half Day</label>
        </rules>
    </decisions>
    <description>Automatically sets Attendance Status based on working hours after check-out.</description>
    <environments>Default</environments>
    <formulas>
        <name>flow_Working_Hours</name>
        <dataType>Number</dataType>
        <expression>($Record.Check_out_Time__c - $Record.Check_in_Time__c) * 24</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Auto Set Attendance Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Auto Set Attendance Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Determine_Attendance_Status</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Check_out_Time__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Check_in_Time__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Leave</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>WFH</stringValue>
            </value>
        </filters>
        <object>Attendance__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
