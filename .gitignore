.sf/
.sfdx/
.localdevserver/
deploy-options.json
*.sfdx
*.sf

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# Local IDE state
.vscode/
.idea/
*.code-workspace

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env
.env.*
!.env.example
!.env.*.example

# Credentials, private keys, and local auth material
.netrc
.npmrc
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
authInfo.json
*authInfo*.json

# Salesforce and test output
*.log
*.trace
test-results/
playwright-report/

# Editor and operating-system state
.history/
.vscode-test/
*.swp
*.swo
*~

# Org-generated integration/default metadata not used by this EMS project
force-app/main/default/flows/sfdc_default_ReportExport_Protection_Flow.flow-meta.xml
force-app/main/default/permissionsets/sfdcInternalInt__sfdc_scrt2.permissionset-meta.xml
